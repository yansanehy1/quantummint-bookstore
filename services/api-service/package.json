{
  "name": "@quantummin/api-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -- src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
    {
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
  },
  "dependencies": {
    "@trpc/server": "^10.45.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.35.0",
    "mysql2": "^3.9.7",
    "cookie": "^0.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.6.3",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2"
  }
}
