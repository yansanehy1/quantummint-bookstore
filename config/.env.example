# QuantumMint Bookstore Environment Variables

# Application
NODE_ENV=development
PORT=3000

# Platform URLs
PLATFORM_URL=https://quantum.quantummint.net
API_BASE_URL=https://quantum.quantummint.net/api
VITE_API_BASE_URL=http://localhost:3000/api

# Database sync (development only — use migrate script in production)
DB_SYNC_ALTER=false
# Use local SQLite file instead of MySQL/Postgres (recommended when MySQL is not running)
DB_USE_SQLITE=true
SQLITE_PATH=./database.sqlite

# Database
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siera
DB_USER=postgres
DB_PASS=your_secure_password_here
DATABASE_URL=postgresql://postgres:${DB_PASS}@localhost:5432/siera

# Redis
REDIS_URL=redis://redis:6379

# JWT & Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_session_secret_here

# Email Service Providers
# SendGrid (Transactional Emails)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Mailchimp (Marketing Emails)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER=us1
MAILCHIMP_LIST_ID=your_list_id_here

# SendGrid Template IDs
SENDGRID_TEMPLATE_WELCOME_BOOKSTORE_01=d-xxxxx
SENDGRID_TEMPLATE_ORDER_CONFIRM_01=d-xxxxx
SENDGRID_TEMPLATE_ORDER_SHIPPED=d-xxxxx
SENDGRID_TEMPLATE_ORDER_OUT_FOR_DELIVERY=d-xxxxx
SENDGRID_TEMPLATE_ORDER_DELIVERED=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_1H=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_24H=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_72H=d-xxxxx
SENDGRID_TEMPLATE_BACK_IN_STOCK=d-xxxxx
SENDGRID_TEMPLATE_PRICE_DROP=d-xxxxx
SENDGRID_TEMPLATE_REVIEW_REQUEST_01=d-xxxxx
SENDGRID_TEMPLATE_SUPPORT_TICKET=d-xxxxx

# Email Testing
EMAIL_TEST_RECIPIENTS=test1@example.com,test2@example.com

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# File Storage
UPLOAD_DIR=/var/www/uploads
MAX_UPLOAD_SIZE=10GB

# External Services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUBSCRIPTION_SERVICE_URL=http://localhost:4100

# Neo4j (Knowledge Graph)
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_URL=bolt://neo4j:7687

# Monitoring
GRAFANA_PASSWORD=your_grafana_password_here

# Encryption
CRYPTO_PRIVATE_KEY=your_crypto_private_key_here

# Mail Server (if self-hosting)
IP_BLACKLIST=192.168.1.100,10.0.0.50

# Session Configuration
SESSION_MAX_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REFUND_SUBMIT_MAX_PER_HOUR=5
REFUND_ADMIN_MAX_PER_WINDOW=60

# Exchange rate (wallet conversions & subscription pricing)
FALLBACK_SLL_TO_USD=59
EXCHANGE_RATE_CACHE_TTL_MS=3600000
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/convert?from=USD&to=SLL&amount=1

# Subscription / refund notifications (optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=noreply@quantummint.net
EMAIL_FROM_NAME=QuantumMint
PUSH_NOTIFICATION_WEBHOOK_URL=

# TTS & STEM Orchestration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here
TTS_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PAYGO_SERVICE_URL=http://localhost:5005
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
