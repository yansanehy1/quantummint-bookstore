# QuantumMint Mail Server Configuration

# Server Configuration
NODE_ENV=development
PORT=8082
API_PORT=8082

# Domain Configuration
MAIL_DOMAIN=quantummint.net
MAIL_HOSTNAME=mail.quantummint.net
MAIL_SERVER_IP=127.0.0.1
WEB_INTERFACE_IP=127.0.0.1

# SMTP Server Configuration
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_SECURE_PORT=465
SMTP_HOSTNAME=mail.quantummint.net

# IMAP Server Configuration
IMAP_PORT=143
IMAP_SECURE_PORT=993
IMAP_HOSTNAME=mail.quantummint.net

# POP3 Server Configuration
POP3_PORT=110
POP3_SECURE_PORT=995
POP3_HOSTNAME=mail.quantummint.net

# TLS/SSL Configuration
TLS_CERT_PATH=./certs
TLS_CERT_FILE=certificate.crt
TLS_KEY_FILE=private.key
TLS_CA_FILE=ca-bundle.crt
ENABLE_TLS=true

# Database Configuration (Shared with Domain Controller)
MONGODB_URI=mongodb://localhost:27017/quantummint-mail
MONGODB_OPTIONS={"useNewUrlParser":true,"useUnifiedTopology":true}

# Redis Configuration (Shared with Domain Controller)
REDIS_URI=redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_KEY_PREFIX=qmail:

# Security Configuration
JWT_SECRET=quantum-mail-dev-secret-change-in-production-2024
API_KEY_SECRET=quantum-api-key-secret-change-in-production
ENCRYPTION_KEY=quantum-32-char-encryption-key!

# Email Authentication
ENABLE_SPF=true
ENABLE_DKIM=true
ENABLE_DMARC=true
DKIM_SELECTOR=quantum
DKIM_PRIVATE_KEY_PATH=./keys/dkim

# Anti-Spam Configuration
ENABLE_ANTISPAM=true
ANTISPAM_ENABLED=true
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783
SPAM_THRESHOLD=5.0

# Anti-Virus Configuration
ENABLE_ANTIVIRUS=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
EMAIL_RATE_LIMIT_WINDOW=60000
EMAIL_RATE_LIMIT_MAX=50
EMAILS_PER_HOUR=100
EMAILS_PER_DAY=1000

# Queue Configuration
QUEUE_CONCURRENCY=10
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=30000
QUEUE_MAX_RETRIES=5
QUEUE_MAX_CONCURRENT=10
QUEUE_CLEANUP_INTERVAL=3600000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Web Interface Configuration
WEB_PORT=8082
WEB_HOST=0.0.0.0
WEB_ENABLE_SSL=false
WEB_SSL_CERT_PATH=
WEB_SSL_KEY_PATH=

# DNS Configuration
DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_TIMEOUT=5000
DNS_RETRIES=3

# DNS Provider Configuration (choose one)
# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Route53
ROUTE53_ACCESS_KEY=
ROUTE53_SECRET_KEY=
ROUTE53_REGION=us-east-1

# DigitalOcean
DIGITALOCEAN_API_TOKEN=

# DMARC Configuration
DMARC_POLICY=quarantine
DMARC_REPORT_EMAIL=dmarc-reports@quantummint.net

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
METRICS_RETENTION_DAYS=7

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_AGGREGATION_INTERVAL=3600000

# External Service Integration
# Mailgun (for backup delivery)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SendGrid (alternative backup)
SENDGRID_API_KEY=

# Notification Configuration
ADMIN_EMAIL=admin@quantummint.net
ALERT_WEBHOOK_URL=
NOTIFICATION_FROM=alerts@quantummint.net

# Performance Configuration
MAX_MESSAGE_SIZE=26214400
MAX_RECIPIENTS_PER_MESSAGE=50
MAX_RECIPIENTS=100
MAX_ATTACHMENTS=10
CONNECTION_TIMEOUT=300000
IDLE_TIMEOUT=1800000

# SMTP Configuration
SMTP_MAX_CONNECTIONS=100
SMTP_BANNER=QuantumMint Mail Server ESMTP
SMTP_AUTH_REQUIRED=true

# IMAP Configuration
IMAP_MAX_CONNECTIONS=100
IMAP_IDLE_TIMEOUT=1800000
IMAP_ENABLE_IDLE=true

# POP3 Configuration
POP3_MAX_CONNECTIONS=50
POP3_SESSION_TIMEOUT=600000

# Allowed Origins (for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,https://quantummint.net
CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_WEB_INTERFACE=true
ENABLE_API=true
ENABLE_ANALYTICS=true
ENABLE_DNS_MANAGEMENT=true
ENABLE_AUTORESPONDER=true
ENABLE_FORWARDING=true
ENABLE_ALIASES=true

# Protocol Servers (set to false to run in HTTP-only mode for debugging)
MAIL_PROTOCOLS_ENABLED=true

# Development/Testing
ENABLE_TEST_MODE=false
TEST_EMAIL_DOMAIN=test.quantummint.net
MOCK_EXTERNAL_SERVICES=false

# QuantumMint Platform Integration
QUANTUMMINT_API_GATEWAY=http://localhost:3000
QUANTUMMINT_AUTH_SERVICE=http://localhost:8080
QUANTUMMINT_DOMAIN_CONTROLLER=http://localhost:8080

# QuantumMint Email Senders (Audiobook Platform)
EMAIL_LISTENING=listen@quantummint.net
EMAIL_CREATORS=creators@quantummint.net
EMAIL_LIBRARY=library@quantummint.net
EMAIL_BILLING=billing@quantummint.net
EMAIL_UPDATES=updates@quantummint.net
EMAIL_SUPPORT=support@quantummint.net

# Legacy senders (for compatibility)
EMAIL_ACCOUNTS=listen@quantummint.net
EMAIL_READING=listen@quantummint.net
EMAIL_PAYOUTS=creators@quantummint.net
EMAIL_CONTENT=library@quantummint.net

# QuantumMint Email Rate Limits
LEARNER_EMAIL_DAILY_LIMIT=10
EDUCATOR_EMAIL_DAILY_LIMIT=5
LOW_BALANCE_ALERT_COOLDOWN=86400

# QuantumMint Business Rules (Audiobook & Video Platform)
WALLET_LOW_BALANCE_THRESHOLD=1.00
AUDIO_RATE_PER_MINUTE=0.15
VIDEO_RATE_STANDARD=0.25
VIDEO_RATE_PREMIUM=0.35
VIDEO_RATE_LIVE=0.50
VIDEO_RATE_INTERACTIVE=0.45
CREATOR_PLATFORM_FEE=0.15
CREATOR_TRANSACTION_FEE=0.25
MINIMUM_PAYOUT=25.00
MAX_DAILY_TOPUP=500.00
MAX_MONTHLY_PAYOUT=5000.00
MINIMUM_SESSION_FOR_SUMMARY=10

# Video-Specific Settings
VIDEO_PROCESSING_TIMEOUT=3600
VIDEO_MAX_DURATION=240
LIVE_STREAM_MAX_DURATION=180
LIVE_STREAM_PREVIEW_MINUTES=5
CERTIFICATE_MIN_COMPLETION=90

# Platform URLs
PLATFORM_URL=https://quantum.quantummint.net
CREATOR_PORTAL_URL=https://quantum.quantummint.net/creator
VIDEO_LIBRARY_URL=https://quantum.quantummint.net/browse/video
CERTIFICATE_VERIFY_URL=https://quantum.quantummint.net/verify

# SMTP Authentication for Sending (Local)
SMTP_AUTH_USER=noreply@quantummint.net
SMTP_AUTH_PASS=
