{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "typeRoots": [
    "./node_modules/@types",
    "./src/types"
  ]
}