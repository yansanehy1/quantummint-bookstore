{
  "name": "@quantummin/user-service",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
    {
  "extends": "../../tsconfig.base.json",
