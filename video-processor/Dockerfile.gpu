FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libavcodec-extra \
    python3 \
    python3-pip \
    curl \
    gnupg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# Install GPU-accelerated ffmpeg dependencies (if needed, though standard ffmpeg often has nvenc support if drivers are present)
# But for full custom build as requested:
RUN apt-get update && apt-get install -y \
    nvidia-video-codec-sdk \
    libnvidia-encode-535 \
    libnvidia-decode-535 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --only=production

COPY . .

# Create GPU-optimized ffmpeg wrapper
RUN echo '#!/bin/bash\n\
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH\n\
    /usr/bin/ffmpeg -hwaccel cuda -hwaccel_output_format cuda "$@"' > /usr/local/bin/gpu-ffmpeg \
    && chmod +x /usr/local/bin/gpu-ffmpeg

# Test GPU availability (will fail during build if no GPU, but useful for runtime check)
# RUN nvidia-smi

USER node
EXPOSE 3001

CMD ["node", "worker.js"]
