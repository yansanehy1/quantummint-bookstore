# Domain Controller Configuration

# Domain Settings
DOMAIN_NAME=quantummint.net
NETBIOS_NAME=QUANTUMMINT
FOREST_NAME=quantummint.net
FOREST_LEVEL=2019
DOMAIN_LEVEL=2019

# LDAP Configuration
LDAP_PORT=389
LDAPS_PORT=636
LDAP_BASE_DN=dc=quantummint,dc=net
LDAP_BIND_DN=cn=Administrator,cn=Users,dc=quantummint,dc=net
LDAP_MAX_CONNECTIONS=1000
LDAP_ENABLE_TLS=true

# Kerberos Configuration
KERBEROS_REALM=QUANTUMMINT.NET
KERBEROS_PORT=88
KERBEROS_ADMIN_PORT=749
KERBEROS_PASSWORD_PORT=464
KERBEROS_TICKET_LIFETIME=10h
KERBEROS_RENEWABLE_LIFETIME=7d
KERBEROS_KEYTAB=/etc/krb5.keytab

# DNS Configuration
DNS_PORT=53
DNS_FORWARDERS=8.8.8.8,8.8.4.4
DNS_ENABLE_RECURSION=true
DNS_ZONES=quantummint.net

# Database Configuration (Shared with Mail Server)
MONGODB_URI=mongodb://localhost:27017/quantummint-domain
REDIS_URI=redis://localhost:6379

# Security Configuration
JWT_SECRET=quantum-domain-dev-secret-change-in-production-2024
ENCRYPTION_KEY=quantum-32-char-encryption-key!
PASSWORD_MIN_LENGTH=8
PASSWORD_COMPLEXITY=true
PASSWORD_HISTORY=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE=90
PASSWORD_HISTORY_COUNT=12
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION=30m
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION=30
LOCKOUT_OBSERVATION_WINDOW=30

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=info
AUDIT_ENABLED_EVENTS=all
AUDIT_LOGON_EVENTS=true
AUDIT_OBJECT_ACCESS=true
AUDIT_PRIVILEGE_USE=true
AUDIT_ACCOUNT_MANAGEMENT=true
AUDIT_POLICY_CHANGE=true
AUDIT_SYSTEM_EVENTS=true

# Web Interface Configuration
WEB_PORT=8080
WEB_HOST=0.0.0.0
WEB_ENABLE_SSL=false
WEB_SSL_CERT_PATH=
WEB_SSL_KEY_PATH=

# Replication Configuration
REPLICATION_ENABLED=false
REPLICATION_INTERVAL=15m
REPLICATION_RETRY_ATTEMPTS=3
REPLICATION_RETRY_DELAY=5m
REPLICATION_PARTNERS=
REPLICATION_COMPRESSION=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/domain-controller.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Rate Limiting
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8082,https://quantummint.net

# JWT Configuration
JWT_EXPIRES_IN=1h

# Protocol Servers (set to false to run in HTTP-only mode for debugging)
DOMAIN_PROTOCOLS_ENABLED=true

# QuantumMint Integration
QUANTUMMINT_API_GATEWAY=http://localhost:3000
QUANTUMMINT_API_URL=http://localhost:3007
QUANTUMMINT_AUTH_SERVICE=http://localhost:3001
QUANTUMMINT_MAIL_SERVER=http://localhost:8082
QUANTUMMINT_API_KEY=
SYNC_INTERVAL=300
ENABLE_USER_SYNC=true
ENABLE_GROUP_SYNC=true

# Development/Production
NODE_ENV=development
