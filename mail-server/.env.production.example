# QuantumMint Mail Server - Production Environment Template
# Save this as .env on your Ubuntu server

# Server Configuration
NODE_ENV=production
PORT=3006
API_PORT=3007

# Domain Configuration
# REPLACE with your actual domain and server IP
MAIL_DOMAIN=yourdomain.com
MAIL_SERVER_IP=your_server_public_ip
WEB_INTERFACE_IP=0.0.0.0

# SMTP Server Configuration
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_SECURE_PORT=465
SMTP_HOSTNAME=mail.yourdomain.com

# IMAP Server Configuration
IMAP_PORT=143
IMAP_SECURE_PORT=993
IMAP_HOSTNAME=mail.yourdomain.com

# POP3 Server Configuration
POP3_PORT=110
POP3_SECURE_PORT=995
POP3_HOSTNAME=mail.yourdomain.com

# TLS/SSL Configuration
TLS_CERT_PATH=/app/certs
TLS_CERT_FILE=certificate.crt
TLS_KEY_FILE=private.key

# Database Configuration (Internal Docker names)
MONGODB_URI=mongodb://mongo:27017/quantummail
REDIS_URI=redis://redis:6379

# Security Configuration
# IMPORTANT: Generate strong keys for these!
JWT_SECRET=generate_a_random_string_here
API_KEY_SECRET=generate_another_random_string
ENCRYPTION_KEY=32_chars_random_encryption_key_

# Email Authentication
ENABLE_SPF=true
ENABLE_DKIM=true
ENABLE_DMARC=true
DKIM_SELECTOR=quantum
DKIM_PRIVATE_KEY_PATH=/app/keys/dkim

# Anti-Spam Configuration
ENABLE_ANTISPAM=true
SPAMASSASSIN_HOST=spamassassin
SPAMASSASSIN_PORT=783

# Anti-Virus Configuration
ENABLE_ANTIVIRUS=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs

# Feature Flags
ENABLE_WEB_INTERFACE=true
ENABLE_API=true
ENABLE_ANALYTICS=true
ENABLE_DNS_MANAGEMENT=true
