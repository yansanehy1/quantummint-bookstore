# QuantumMint Bookstore Environment Variables

# Application
NODE_ENV=development
PORT=3000

# Platform URLs
PLATFORM_URL=https://quantum.quantummint.net
API_BASE_URL=https://quantum.quantummint.net/api

# Database
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/siera

# Redis
REDIS_URL=redis://redis:6379

# JWT & Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_session_secret_here

# Email Service Providers
# SendGrid (Transactional Emails)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Mailchimp (Marketing Emails)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER=us1
MAILCHIMP_LIST_ID=your_list_id_here

# SendGrid Template IDs
SENDGRID_TEMPLATE_WELCOME_BOOKSTORE_01=d-xxxxx
SENDGRID_TEMPLATE_ORDER_CONFIRM_01=d-xxxxx
SENDGRID_TEMPLATE_ORDER_SHIPPED=d-xxxxx
SENDGRID_TEMPLATE_ORDER_OUT_FOR_DELIVERY=d-xxxxx
SENDGRID_TEMPLATE_ORDER_DELIVERED=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_1H=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_24H=d-xxxxx
SENDGRID_TEMPLATE_CART_ABANDONED_72H=d-xxxxx
SENDGRID_TEMPLATE_BACK_IN_STOCK=d-xxxxx
SENDGRID_TEMPLATE_PRICE_DROP=d-xxxxx
SENDGRID_TEMPLATE_REVIEW_REQUEST_01=d-xxxxx
SENDGRID_TEMPLATE_SUPPORT_TICKET=d-xxxxx

# Email Testing
EMAIL_TEST_RECIPIENTS=test1@example.com,test2@example.com

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# File Storage
UPLOAD_DIR=/var/www/uploads
MAX_UPLOAD_SIZE=10GB

# External Services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUBSCRIPTION_SERVICE_URL=http://localhost:4100

# Neo4j (Knowledge Graph)
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_URL=bolt://neo4j:7687

# Monitoring
GRAFANA_PASSWORD=your_grafana_password_here

# Encryption
CRYPTO_PRIVATE_KEY=your_crypto_private_key_here

# Mail Server (if self-hosting)
IP_BLACKLIST=192.168.1.100,10.0.0.50

# Session Configuration
SESSION_MAX_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
