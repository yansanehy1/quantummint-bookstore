{
  "dashboard": {
    "title": "QuantumMint Video Processing",
    "panels": [
      {
        "title": "Queue Depth",
        "type": "stat",
        "targets": [{
          "expr": "video_queue_depth",
          "legendFormat": "Jobs waiting"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "title": "Processing Time by Quality",
        "type": "heatmap",
        "targets": [{
          "expr": "rate(video_processing_duration_seconds_bucket[5m])",
          "legendFormat": "{{quality}}"
        }]
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "targets": [{
          "expr": "rate(video_processing_errors_total[5m])",
          "legendFormat": "{{error_type}}"
        }]
      },
      {
        "title": "Stream Throughput",
        "type": "timeseries",
        "targets": [{
          "expr": "rate(video_stream_bytes_total[1m])",
          "legendFormat": "{{format}}"
        }]
      }
    ]
  }
}
