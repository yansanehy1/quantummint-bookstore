# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# DATABASE (Hostinger MySQL via phpMyAdmin)
# ============================================
# Get these from Hostinger control panel > Databases
DATABASE_HOST=your-hostinger-mysql-host.com
DATABASE_PORT=3306
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Full connection string (alternative format)
DATABASE_URL=mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ============================================
# REDIS (Upstash)
# ============================================
# Sign up at https://upstash.com
# Create a Redis database and get the connection URL
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# ============================================
# AUTHENTICATION
# ============================================
# Generate a secure random string for JWT signing
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Session secret for cookie signing
SESSION_SECRET=your-session-secret-min-32-characters

# ============================================
# STRIPE (Payment Processing)
# ============================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook secret for Stripe events
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# TWILIO (SMS Service)
# ============================================
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production

# Frontend URL (your Hostinger domain)
FRONTEND_URL=https://yourdomain.com

# API URLs (Fly.io apps)
API_GATEWAY_URL=https://quantummint-core.fly.dev
BUSINESS_API_URL=https://quantummint-business.fly.dev
SUPPORT_API_URL=https://quantummint-support.fly.dev

# ============================================
# CORS SETTINGS
# ============================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# EMAIL (Optional - if you add email service)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# FILE STORAGE (Optional - if using cloud storage)
# ============================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
