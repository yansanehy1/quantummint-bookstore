  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
  },
  "dependencies": {
    "@quantummin/shared": "*",
    "drizzle-orm": "^0.35.3",
    "express": "^4.19.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
