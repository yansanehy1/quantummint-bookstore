# Backend Environment Variables Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=password
DB_NAME=quantummint_bookstore

# Security
JWT_SECRET=your_jwt_secret_here

# External Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# Exchange Rate Service
# FALLBACK_SLL_TO_USD=59
# EXCHANGE_RATE_CACHE_TTL_MS=3600000
# EXCHANGE_RATE_API_URL=https://api.exchangerate.host/convert?from=USD&to=SLL&amount=1

# Email Service (SendGrid)
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@quantummint.net

# Refund Limits
# REFUND_SUBMIT_MAX_PER_HOUR=5
# REFUND_ADMIN_MAX_PER_WINDOW=60

# Feature Flags
# DISABLE_SUBSCRIPTION_WORKER=false
